# Vault-Payments development secrets.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# is verified by tests/secrets.test.ts to never be committable — but do not
# rely on that alone: keep real keys out of any file that could be staged.
#
# This file is a template with no secret values and is safe to commit.

# ---------------------------------------------------------------------------
# Stripe — TEST MODE ONLY for this project.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# A test-mode secret key starts with `sk_test_`.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe webhook signing secret.
#
# For local development use the Stripe CLI, which both forwards events to a
# local URL and prints its own signing secret:
#
#   stripe listen --forward-to localhost:3000/webhooks/stripe
#
# It prints `whsec_...` — put that here. A webhook endpoint created in the
# Stripe dashboard has a DIFFERENT signing secret, so local testing and
# production verification use different values.
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=

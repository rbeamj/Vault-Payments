# Generated by Vault-Payments for Stripe.
#
# Never commit real values. Secrets are read from the environment at runtime;
# nothing is ever written into source code by the generator.

# STRIPE_SECRET_KEY — REQUIRED (secret)
#   Secret API key. `sk_test_…` in sandbox, `sk_live_…` in production.
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET — REQUIRED (secret)
#   Endpoint signing secret (`whsec_…`) used to verify inbound webhooks.
STRIPE_WEBHOOK_SECRET=

# VAULT_ENVIRONMENT — optional
#   Target environment: 'sandbox' (default) or 'live'.
VAULT_ENVIRONMENT=

# VAULT_ALLOW_LIVE — optional
#   Must be 'true' to permit the live base URL. Refused otherwise.
VAULT_ALLOW_LIVE=
